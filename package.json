{
  "name": "cybergrid",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, cross-platform terminal and remote connection manager.",
  "main": "build/main/main.js",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf build",
    "clean:artifacts": "rimraf dist",
    "build": "npm run clean && npm run typecheck && node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist:win": "npm run clean:artifacts && npm run build && electron-builder --win --x64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurlyDeer/cybergrid.git"
  },
  "keywords": [
    "electron",
    "ssh",
    "terminal",
    "remote-desktop"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KurlyDeer/cybergrid/issues"
  },
  "homepage": "https://github.com/KurlyDeer/cybergrid#readme",
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "5.10.1",
    "mac-oui-lookup": "1.1.4",
    "serialport": "13.0.0",
    "ssh2": "^1.17.0",
    "ws": "8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "8.18.1",
    "electron": "^43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.kurlydeer.cybergrid",
    "productName": "CyberGrid",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/@serialport/bindings-cpp/**/*",
      "node_modules/cpu-features/**/*",
      "node_modules/ssh2/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KurlyDeer",
        "repo": "cybergrid",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberGrid",
      "uninstallDisplayName": "CyberGrid Remote Desktop Manager",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
