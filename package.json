{
  "name": "cybergrid",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, cross-platform terminal and remote connection manager.",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && node scripts/copy-static.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurlyDeer/cybergrid.git"
  },
  "keywords": [
    "electron",
    "ssh",
    "terminal",
    "remote-desktop"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KurlyDeer/cybergrid/issues"
  },
  "homepage": "https://github.com/KurlyDeer/cybergrid#readme",
  "dependencies": {
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "electron": "^43.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
